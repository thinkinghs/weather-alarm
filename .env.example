# ============================================================
# 이 파일을 복사하여 .env 파일을 만든 뒤 실제 값을 채워주세요.
#   cp .env.example .env
# .env 파일은 절대 커밋하지 마세요 (.gitignore에 포함됨)
# ============================================================

# 기상청 공공데이터포털 API 키 (https://www.data.go.kr)
KMA_API_KEY=your_kma_api_key_here

# 한국환경공단 에어코리아 API 키 (https://www.data.go.kr)
AIRKOREA_API_KEY=your_airkorea_api_key_here

# LINE Messaging API (https://developers.line.biz)
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_USER_ID=your_line_user_id_here

# 위치 설정 (기본값: 경기도 성남시 분당구)
LOCATION_NX=61           # 기상청 격자 X 좌표
LOCATION_NY=120          # 기상청 격자 Y 좌표
SIDO_NAME=경기            # 에어코리아 시도명
STATION_NAME=서현동        # 에어코리아 측정소명
LOCATION_DISPLAY_NAME=경기도 성남시 분당구   # 메시지에 표시될 지역명
